# Copy to deploy/.env, fill every required value, and run chmod 600 deploy/.env.
POSTGRES_DB=gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
PUBLIC_ORIGIN=https://gallery.example.com
TRUSTED_PROXY=127.0.0.1
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SCRAPER_ENABLED=false
SCRAPER_LOGIN=
SCRAPER_PASSWORD=
SCRAPER_IMAGE_HOST=lessonsinlovegame.com
EMBEDDING_ENABLED=true
MODEL_PATH=/srv/gallery/model/model.onnx
GALLERY_IMAGE_TAG=latest
